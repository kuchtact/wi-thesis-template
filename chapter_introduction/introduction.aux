\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces This figure shows an example reconnection configuration on the scale of the ion skin depth for collisionless reconnection. The green arrows show the direction of flow into the x-point. Electrons trapped in a flux tube far from the x-point (with distribution function in panel A) are convected towards a region of lower field causing the flux tube to widen vertically (panel B). To enforce quasineutrality this requires the tubes to shorten in the parallel direction. The passing electrons (in green and purple which originate from a Maxwellian distribution) move to higher $v_\parallel $ whereas trapped electrons get smeared out causing the distribution to have an increasingly large $T_\parallel $ and smaller $T_\perp $.}}{6}{figure.caption.20}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:flux_tube_evolution}{{1.1}{6}{This figure shows an example reconnection configuration on the scale of the ion skin depth for collisionless reconnection. The green arrows show the direction of flow into the x-point. Electrons trapped in a flux tube far from the x-point (with distribution function in panel A) are convected towards a region of lower field causing the flux tube to widen vertically (panel B). To enforce quasineutrality this requires the tubes to shorten in the parallel direction. The passing electrons (in green and purple which originate from a Maxwellian distribution) move to higher $v_\parallel $ whereas trapped electrons get smeared out causing the distribution to have an increasingly large $T_\parallel $ and smaller $T_\perp $}{figure.caption.20}{}}
