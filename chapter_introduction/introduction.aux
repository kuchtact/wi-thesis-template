\@writefile{lof}{\contentsline {figure}{\numberline {1.3}{\ignorespaces Simulated kinetic reconnection with changing guide field reproduced from \cite  {Le_Egedal_Ohia_Daughton_Karimabadi_Lukin_2013}. The top four panels, (a - d), show results from a full mass ratio PIC simulation of reconnection with varying guide field ratios given by pink squares on left. At the bottom is a fluid simulation with a closure that allows for pressure anisotropy. As guide field changes, the outflow characteristics evolve from current that follows the separatrices at low field, an additional current jet that pierce the center of the outflow at moderate field, and a return to two jets at high field.}}{9}{figure.caption.26}\protected@file@percent }
\newlabel{fig:variable_guide_field}{{1.3}{9}{Simulated kinetic reconnection with changing guide field reproduced from \cite {Le_Egedal_Ohia_Daughton_Karimabadi_Lukin_2013}. The top four panels, (a - d), show results from a full mass ratio PIC simulation of reconnection with varying guide field ratios given by pink squares on left. At the bottom is a fluid simulation with a closure that allows for pressure anisotropy. As guide field changes, the outflow characteristics evolve from current that follows the separatrices at low field, an additional current jet that pierce the center of the outflow at moderate field, and a return to two jets at high field}{figure.caption.26}{}}
\@writefile{toc}{\contentsline {subparagraph}{Moderate field}{9}{section*.25}\protected@file@percent }
