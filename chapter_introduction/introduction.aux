\@writefile{lof}{\contentsline {figure}{\numberline {1.3}{\ignorespaces Simulated kinetic reconnection with changing guide field reproduced from \cite  {Le_Egedal_Ohia_Daughton_Karimabadi_Lukin_2013}. The top four panels, (a - d), show results from a full mass ratio PIC simulation of reconnection with a guide field of various amounts in pink squares on left. At the bottom is a fluid simulation with a closure that allows for pressure anisotropy. With varying guide field, the outflow characteristics change where very low or no guide field leads to no jets, moderate field leads to jets that pierce the center of the outflow, and high guide field returns to an outflow similar to the low guide field case.}}{9}{figure.caption.12}\protected@file@percent }
\newlabel{fig:variable_guide_field}{{1.3}{9}{Simulated kinetic reconnection with changing guide field reproduced from \cite {Le_Egedal_Ohia_Daughton_Karimabadi_Lukin_2013}. The top four panels, (a - d), show results from a full mass ratio PIC simulation of reconnection with a guide field of various amounts in pink squares on left. At the bottom is a fluid simulation with a closure that allows for pressure anisotropy. With varying guide field, the outflow characteristics change where very low or no guide field leads to no jets, moderate field leads to jets that pierce the center of the outflow, and high guide field returns to an outflow similar to the low guide field case}{figure.caption.12}{}}
\@writefile{toc}{\contentsline {subparagraph}{\numberline {1.2.2.2.1.2}High field}{9}{subparagraph.1.2.2.2.1.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subparagraph}{\numberline {1.2.2.2.1.3}Goldilocks!}{9}{subparagraph.1.2.2.2.1.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1.4}{\ignorespaces PIC simulations of reconnection from \cite  {Le_Egedal_Ohia_Daughton_Karimabadi_Lukin_2013}. The top row shows a moderate guide field run and the bottom row a low guide field run. With sufficiently high field, the pressure anisotropy in panel (a) stays in the outflow as compared to the low guide field. This leads to a marginal firehose condition of order $0.5$ (panel (b)) in the outflow which supports sharply bent field lines and a current jet in the center of the outflow (panel (c)).}}{10}{figure.caption.13}\protected@file@percent }
