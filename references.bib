@article{Zwolak_et_al_2007,
author = {Zwolak, Jason W. and Boggs, Paul T. and Watson, Layne T.},
title = {Algorithm 869: ODRPACK95: A weighted orthogonal distance regression code with bound constraints},
year = {2007},
